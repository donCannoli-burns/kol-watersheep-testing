#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MODE="${1:-start}"

if ! command -v node >/dev/null 2>&1 || ! command -v npm >/dev/null 2>&1; then
  echo "BLOCKED: Node.js 20+ and npm are required." >&2
  exit 2
fi
if [[ ! -x "$HERE/node_modules/.bin/tsx" ]]; then
  echo "BLOCKED: dependencies are not installed. Run: npm install" >&2
  exit 2
fi

cd "$HERE"
case "$MODE" in
  test) exec npm test --silent ;;
  smoke) exec npm run smoke --silent ;;
  watersheep-baseline) exec npm run watersheep-baseline --silent ;;
  watersheep-baseline-analysis) exec npm run watersheep-baseline-analysis --silent ;;
  watersheep-order) exec npm run watersheep-order --silent ;;
  watersheep-repeat) exec npm run watersheep-repeat --silent ;;
  watersheep-interactions) exec npm run watersheep-interactions --silent ;;\n  watersheep-minpair) exec npm run watersheep-minpair --silent ;;
  start) exec npm run start --silent ;;
  *)
    echo "usage: $0 [test|smoke|watersheep-baseline|watersheep-baseline-analysis|watersheep-order|watersheep-repeat|watersheep-interactions|watersheep-minpair|start]" >&2
    exit 2
    ;;
esac
